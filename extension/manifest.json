{
  "manifest_version": 3,
  "name": "SellerSalt — Etsy Seller Intelligence",
  "version": "1.0.0",
  "description": "SellerSalt Etsy SEO Assistant: pairs with your SellerSalt account, scores your listing editor in real time, and lets you preview and apply title/tag suggestions.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SellerSalt",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://sellersalt.com/*",
    "https://staging.sellersalt.com/*",
    "http://localhost:3000/*",
    "https://*.etsy.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sellersalt.com/*",
        "https://staging.sellersalt.com/*",
        "http://localhost:3000/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.etsy.com/*"],
      "js": ["etsy-content-script.js"],
      "type": "module",
      "run_at": "document_idle"
    }
  ]
}
