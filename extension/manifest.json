{
  "manifest_version": 3,
  "name": "SellerSalt — Etsy Seller Intelligence",
  "version": "1.0.0",
  "description": "SellerSalt Assistant: pairs with your SellerSalt account to bring listing opportunity scoring, shop market research, and search scanning into a side panel. Operates entirely through the SellerSalt web app's own API — it never reads or writes any content on Etsy's site.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SellerSalt",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://sellersalt.com/*",
    "https://staging.sellersalt.com/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sellersalt.com/*",
        "https://staging.sellersalt.com/*",
        "http://localhost:3000/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
