# --- Database ---
DATABASE_URL=postgresql://anadash:changeme@postgres:5432/anadash

# --- Redis (job queue) ---
REDIS_URL=redis://redis:6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=replace_with_generated_secret
NEXTAUTH_URL=https://staging.sellersalt.com
# For local dev: NEXTAUTH_URL=http://localhost:3000
# For production: NEXTAUTH_URL=https://sellersalt.com

# --- Encryption for stored connector credentials (Etsy API keys, etc.) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace_with_generated_key
