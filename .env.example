# ==============================================================================
# SELLER SALT — CANONICAL PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development, or configure these keys in
# your production deployment environment (Coolify, Vercel, Railway, AWS ECS, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE (REQUIRED_FOR_BOOT)
# ------------------------------------------------------------------------------
# PostgreSQL database URI (include ?pgbouncer=true if using external pooler)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sellersalt?sslmode=prefer"

# NextAuth base URL (public URL of your deployment)
NEXTAUTH_URL="http://localhost:3000"

# NextAuth JWT encryption secret (generate via: openssl rand -base64 32)
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret-in-production"

# AES-256-GCM master encryption key for token & credential storage at rest
# (generate 64 hex characters via: openssl rand -hex 32)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 2. COMMERCIAL BILLING & SUBSCRIPTIONS (REQUIRED_FOR_BILLING)
# ------------------------------------------------------------------------------
# Stripe API Keys (from Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# PayPal REST API Keys (from developer.paypal.com)
PAYPAL_CLIENT_ID="A..."
PAYPAL_CLIENT_SECRET="E..."
PAYPAL_WEBHOOK_ID="8..."

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL (REQUIRED_FOR_EMAIL)
# ------------------------------------------------------------------------------
# Outbound SMTP Configuration (e.g. Postmark, Resend, SendGrid, Amazon SES)
SMTP_HOST="smtp.postmarkapp.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username-or-token"
SMTP_PASS="your-smtp-password-or-token"
EMAIL_FROM="SellerSalt <noreply@sellersalt.com>"

# Fallback AWS SES (optional alternative to SMTP)
# AWS_SES_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."

# ------------------------------------------------------------------------------
# 4. MARKETPLACE INTEGRATIONS (REQUIRED_FOR_MARKETPLACE_INTEGRATIONS)
# ------------------------------------------------------------------------------
# Etsy OpenAPI v3 OAuth 2.0 Credentials (from etsy.com/developers)
ETSY_CLIENT_ID="your-etsy-keystring-client-id"
ETSY_CLIENT_SECRET="your-etsy-client-secret"

# ------------------------------------------------------------------------------
# 5. PRIVATE BETA ACCESS CONTROL (OPTIONAL)
# ------------------------------------------------------------------------------
# Set to "true" to gate access behind invitation codes
PRIVATE_BETA_MODE="false"
BETA_INVITE_CODES="SALT-BETA-2026,EARLY-FOUNDER,SELLER-SALT-VIP"

# ------------------------------------------------------------------------------
# 6. CACHING, WORKERS & AI (OPTIONAL)
# ------------------------------------------------------------------------------
# Redis instance for BullMQ background workers and distributed caching
REDIS_URL="redis://localhost:6379"

# Comma-separated list of superadmin user email addresses
ADMIN_EMAILS="admin@sellersalt.com"

# OpenAI / Anthropic API Keys for AI Listing Studio and SaltBot
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
