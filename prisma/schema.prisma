// Anadash data model
// Multi-tenant from day one: every business-data table carries organizationId,
// even though the UI only exposes a single org per user for now.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity & tenancy ----------

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      Plan     @default(FREE)
  packageId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  connectors  Connector[]
  searchConfigs SearchConfig[]
  prospects   Prospect[]
  jobs        Job[]
  shopWatches ShopWatch[]
  package     Package?     @relation(fields: [packageId], references: [id])
  invites     Invite[]
  sellerChannels SellerChannel[]
  crossListings CrossListing[]
  subscription Subscription?
  plannedKeywords PlannedKeyword[]
  plannerItems PlannerItem[]
  listingDrafts ListingDraft[]
  listingSeoAudits ListingSeoAudit[]
  etsyExecutionLogs EtsyExecutionLog[]
  listingWatches ListingWatch[]
  trackingAlerts TrackingAlert[]
}

enum Plan {
  FREE
  PRO
  AGENCY
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  suspendedAt   DateTime?
  // Null = not yet confirmed. Set by GET /api/auth/verify-email when a
  // valid token is redeemed, or automatically on any Google/Etsy OAuth
  // sign-in (that identity is already provider-verified). Pre-existing
  // accounts are backfilled to "verified at signup" in this field's
  // migration, so this only gates new signups going forward, not everyone
  // who was already using the app.
  emailVerified DateTime?
  // Tracks the capped automatic reminder sequence (signup + ~6h + ~18h,
  // max 3 total within a 24h window) and any admin/user-triggered resend —
  // all sends share the same counter so the cap can never be bypassed by
  // mixing automatic and manual sends. Window resets 24h after the first
  // send in the current cycle, so a user who never verifies can still ask
  // for a fresh link later rather than being locked out forever.
  verificationEmailCount   Int       @default(0)
  verificationFirstSentAt  DateTime?
  lastVerificationEmailAt  DateTime?
  // Every distinct method this account has ever successfully authenticated
  // with ("credentials" | "google" | "etsy" | "passkey") — appended to on
  // each successful sign-in. There's no NextAuth Account/Session adapter
  // table in this schema (JWT session strategy only), so this is the only
  // record of "how has this person signed in" for the admin Users table.
  authMethods   String[] @default([])
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships Membership[]
  passwordResetTokens PasswordResetToken[]
  webAuthnCredentials WebAuthnCredential[]
  createdPlannerItems PlannerItem[]
  etsyExecutionLogs   EtsyExecutionLog[]
}

// One row per registered passkey/security key. credentialId is the
// authenticator-issued identifier (base64url) — looked up globally at
// login time, before we know which user is signing in, which is why it's
// unique and indexed rather than only scoped by userId. counter is a
// signature-replay guard per the WebAuthn spec: it must strictly increase
// on every use, and a non-increasing value on a real assertion indicates
// a cloned authenticator.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    String
  counter      BigInt    @default(0)
  deviceType   String
  backedUp     Boolean   @default(false)
  transports   String?
  name         String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(OWNER)
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

// ---------- Marketplace connectors ----------
// One row per (organization, marketplace) connection. Etsy is connector #1;
// Amazon/AliExpress/Shopify sourcing etc. reuse this same table + a `type` discriminator.

model Connector {
  id             String   @id @default(cuid())
  // Nullable: null means this is a platform-owned connector, shared by every
  // paying org (the normal case — customers don't bring their own API key,
  // they just use the service). Non-null means an org brought its own key,
  // an opt-in premium option, not something a regular user is asked to do.
  organizationId String?
  type           ConnectorType
  label          String   // user-facing name, e.g. "Etsy - Netdrix Sourcing"
  // Secrets are encrypted at rest (see src/lib/encryption.ts) before being stored here.
  encryptedCredentials String
  status         ConnectorStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  searchConfigs SearchConfig[]
  jobs         Job[]
  shopWatches  ShopWatch[]

  @@index([organizationId])
}

enum ConnectorType {
  ETSY
  // AMAZON, ALIEXPRESS, SHOPIFY_SOURCING, etc. added as phase 2 connectors ship
}

enum ConnectorStatus {
  ACTIVE
  ERROR
  DISABLED
}

// ---------- User-defined search / prospecting configs ----------
// This replaces the old .env keyword list — now editable per-org in the dashboard.

model SearchConfig {
  id             String   @id @default(cuid())
  organizationId String
  connectorId    String
  name           String
  keywords       String[] // e.g. ["digital planner", "svg bundle"]
  minPrice       Float
  maxPrice       Float
  minShopAgeMonths Float  @default(12)
  maxShopAgeMonths Float  @default(24)
  minReviewCount   Int    @default(20)
  scheduleCron   String?  // null = manual run only
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector    Connector    @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  jobs         Job[]
  prospects    Prospect[]

  @@index([organizationId])
}

// ---------- Jobs (background runs, replaces the old cron-only script) ----------

model Job {
  id             String   @id @default(cuid())
  organizationId String
  connectorId    String
  searchConfigId String
  status         JobStatus @default(QUEUED)
  triggeredBy    JobTrigger @default(USER)
  startedAt      DateTime?
  finishedAt     DateTime?
  resultCount    Int?
  errorMessage   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector    Connector    @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  searchConfig SearchConfig @relation(fields: [searchConfigId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
}

enum JobTrigger {
  USER
  SCHEDULE
}

// ---------- Prospects (the actual output data, replaces the Google Sheet) ----------

model Prospect {
  id             String   @id @default(cuid())
  organizationId String
  searchConfigId String
  jobId          String?
  marketplace    ConnectorType @default(ETSY)
  keyword        String
  // External marketplace IDs — present on every row, including historical ones,
  // so repeated runs of the same search naturally form a time series per shop
  // and per listing without needing a separate snapshot table.
  shopExternalId    String
  listingExternalId String
  shopName       String
  shopUrl        String
  shopIconUrl    String?
  shopAgeMonths  Float
  reviewCount    Int
  activeListings Int
  reviewRatio    Float
  reviewVelocity Float
  // Real lifetime sales count (Etsy's transaction_sold_count) where the marketplace
  // exposes it — not a proxy. avgSellingRatio/estDailySales are derived from this.
  totalSales      Int?
  reviewAverage   Float?
  numFavorers     Int?
  avgSellingRatio Float?
  estDailySales   Float?
  listingTitle    String
  listingUrl      String
  listingImageUrl String?
  price          Float
  status         ProspectStatus @default(PENDING_REVIEW)
  isFavorite     Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  searchConfig SearchConfig @relation(fields: [searchConfigId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([isFavorite])
  @@index([shopExternalId])
  @@index([listingExternalId])
  @@index([jobId])
}

enum ProspectStatus {
  PENDING_REVIEW
  SHORTLISTED
  CONTACTED
  REJECTED
}

// ---------- Shop tracking ("Spy on Competitor") ----------
// Independent of SearchConfig: a user can start tracking any shop they find in
// Prospects, regardless of which search surfaced it. A repeatable BullMQ job
// (one per ShopWatch) re-fetches just that shop's stats on a schedule and
// appends a ShopSnapshot — the interactive sales-trend graph on the shop page
// is built entirely from this table.

model ShopWatch {
  id             String   @id @default(cuid())
  organizationId String
  connectorId    String
  shopExternalId String
  shopName       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector    Connector       @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  snapshots    ShopSnapshot[]

  @@unique([organizationId, shopExternalId])
  @@index([organizationId])
}

model ShopSnapshot {
  id             String   @id @default(cuid())
  shopWatchId    String
  totalSales     Int?
  reviewCount    Int
  reviewAverage  Float?
  activeListings Int
  numFavorers    Int?
  capturedAt     DateTime @default(now())

  shopWatch ShopWatch @relation(fields: [shopWatchId], references: [id], onDelete: Cascade)

  @@index([shopWatchId])
  @@index([capturedAt])
}

// ---------- Listing tracking (Longitudinal Listing Surveillance) ----------
model ListingWatch {
  id                String   @id @default(cuid())
  organizationId    String
  listingExternalId String
  shopExternalId    String?
  shopName          String?
  title             String
  url               String?
  imageUrl          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshots    ListingSnapshot[]

  @@unique([organizationId, listingExternalId])
  @@index([organizationId])
  @@index([listingExternalId])
}

model ListingSnapshot {
  id             String   @id @default(cuid())
  listingWatchId String
  price          Float?
  currency       String?
  quantity       Int?
  numFavorers    Int?
  state          String?
  capturedAt     DateTime @default(now())

  listingWatch ListingWatch @relation(fields: [listingWatchId], references: [id], onDelete: Cascade)

  @@index([listingWatchId])
  @@index([capturedAt])
}

// ---------- Tracking Alerts (Spike & Competitor Anomaly Detection) ----------
model TrackingAlert {
  id             String   @id @default(cuid())
  organizationId String
  targetType     String   // "SHOP" | "LISTING"
  targetId       String   // shopExternalId or listingExternalId
  targetTitle    String
  eventType      String   // "SALES_SPIKE" | "VELOCITY_ACCELERATION" | "PRICE_DROP" | "CATALOG_SURGE"
  severity       String   // "INFO" | "WARNING" | "CRITICAL"
  message        String
  previousValue  Float?
  currentValue   Float?
  delta          Float?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([targetId])
  @@index([createdAt])
}

// A real, persisted "add to keyword planning" list — not derived from
// existing Prospect rows. sourceShopExternalId/sourceListingUrl are
// optional provenance (where the keyword was spotted), kept so the
// Planning UI can link back to the evidence rather than showing a bare
// string.
model PlannedKeyword {
  id                   String   @id @default(cuid())
  organizationId       String
  keyword              String
  sourceShopExternalId String?
  sourceListingUrl     String?
  createdAt            DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, keyword])
  @@index([organizationId])
}

// ---------- Packages (plan tiers) ----------
// Replaces hardcoded plan limits with DB-editable rows, so pricing/limits can
// change without a redeploy. Three standard tiers (Free/Pro/Agency) seed
// automatically on first use; isCustom rows are one-off overrides an admin
// assigns to a specific org (special deals, beta customers, etc.).

model Package {
  id       String  @id @default(cuid())
  key      String  @unique
  name     String
  priceUsd Float   @default(0)
  isCustom Boolean @default(false)
  // Inactive packages are hidden from the public pricing page and checkout,
  // but existing organizations already on one keep working — this is a
  // visibility/sales toggle, not a hard cutoff.
  isActive Boolean @default(true)

  maxConnectors        Int @default(1)
  maxSearchConfigs     Int @default(3)
  maxScheduledSearches Int @default(1)
  maxTrackedShops      Int @default(5)
  maxProspectsPerMonth Int @default(200)
  maxSellerChannels    Int @default(2)

  // Cached after first PayPal checkout for this package — PayPal requires a
  // pre-created Plan resource, unlike Stripe's fully dynamic inline pricing.
  // Created lazily rather than requiring manual PayPal dashboard setup per
  // package, so DB-edited pricing stays the single source of truth.
  paypalProductId String?
  paypalPlanId    String?

  // Trial billing — all current plans use a small immediate charge (not
  // $0) as both a card-verification step and genuine trial fee, then
  // convert to the full recurring price automatically when the trial ends.
  // Nullable because not every package needs to be trial-gated (e.g. a
  // future promotional or invite-only tier might skip this).
  trialDays     Int?
  trialPriceUsd Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]
  subscriptions Subscription[]
}

// ---------- Payment providers ----------
// Platform-level, not per-org — Anadash itself is the merchant of record.
// Credentials are stored encrypted at rest, same pattern as marketplace
// Connector. Live checkout/webhook handling per provider is a separate,
// later increment — this is the admin-side "store the credentials, mark
// which ones are active" foundation that unlocks it without a schema change.

model PaymentProvider {
  id       String              @id @default(cuid())
  provider PaymentProviderType @unique
  label    String
  isActive Boolean             @default(false)
  // Mode is which credential set is currently used for real calls — separate
  // from isActive (whether the provider is enabled at all). Both credential
  // sets can be stored simultaneously so switching modes for testing doesn't
  // require re-entering keys every time.
  mode     PaymentProviderMode @default(SANDBOX)
  encryptedLiveCredentials    String?
  encryptedSandboxCredentials String?
  // Lower number = shown first / treated as default. Only meaningful among
  // active providers — the lowest-priority active one is the "recommended"
  // option on the Billing page, others show as secondary alternatives in
  // ascending priority order.
  priority Int @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentProviderMode {
  LIVE
  SANDBOX
}

enum PaymentProviderType {
  STRIPE
  PAYPAL
  SAFEPAY
  PAYFAST
  // Admin-granted subscription with no real payment provider behind it —
  // used to manually assign/grandfather an org onto a plan.
  MANUAL
}

// ---------- AI provider / model registry ----------
// Fixes the root cause of SaltBot's LLM calls failing silently: model IDs
// were hardcoded per provider in code (e.g. a specific OpenRouter free-tier
// slug), with no way to know if that model still exists on the provider's
// side. This table is a real, admin-refreshable catalog fetched from each
// provider's own model-list API — never invented — so a hardcoded string
// can never again drift out from under a working API key.
model AiProvider {
  id       String         @id @default(cuid())
  provider AiProviderType @unique
  label    String
  isActive Boolean        @default(false)
  encryptedApiKey String?
  // The modelId (AiModel.modelId, not a hard FK) actually used for real
  // calls. Loose reference rather than a relation because the model catalog
  // is wholesale-replaced on every discovery refresh — a hard FK would
  // require special-casing "the currently selected model" during a refresh.
  defaultModelId String?
  // SaltBot's LLM fallback order — lower number tried first among active
  // providers. Defaults match the already-documented OpenRouter -> NVIDIA
  // -> Gemini -> OpenAI chain.
  priority Int @default(100)

  modelsLastFetchedAt DateTime?
  lastTestedAt        DateTime?
  lastTestOk          Boolean?
  lastTestMessage     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models AiModel[]

  @@index([priority])
}

enum AiProviderType {
  OPENROUTER
  NVIDIA
  GEMINI
  OPENAI
}

// One row per model reported by a provider's own catalog endpoint at the
// last refresh. Wholesale-replaced (delete + reinsert) on each "Refresh
// Models" — this is a cache of provider-reported truth, not something
// SellerSalt edits piecemeal.
model AiModel {
  id                       String   @id @default(cuid())
  providerId               String
  modelId                  String
  displayName              String
  contextLength            Int?
  // USD per 1M tokens. Null when the provider doesn't report pricing for
  // this model (never fabricated).
  inputPricePerMillion     Float?
  outputPricePerMillion    Float?
  isFree                   Boolean  @default(false)
  supportsVision           Boolean  @default(false)
  supportsTools            Boolean  @default(false)
  supportsStructuredOutput Boolean  @default(false)
  // Full provider-reported metadata blob, kept alongside the extracted
  // fields above so future capability checks don't need another migration.
  raw                      Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelId])
  @@index([providerId])
}

// ---------- Subscriptions ----------
// One row per org's current subscription state. Driven by webhooks, not by
// the initial checkout response — renewals, failures, and cancellations all
// happen asynchronously and must be reflected here for Organization.packageId
// to stay correct.

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  packageId            String
  provider             PaymentProviderType
  providerCustomerId   String?
  providerSubscriptionId String?          @unique
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package      Package      @relation(fields: [packageId], references: [id])

  @@index([organizationId])
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// Discount codes applied at checkout — reduce both the one-time trial
// charge and the recurring price on whichever package they're redeemed
// against.
model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Float
  isActive        Boolean    @default(true)
  maxRedemptions  Int?
  redemptionCount Int        @default(0)
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

enum CouponType {
  PERCENT
  FIXED
}

// Idempotency log — every provider can retry-deliver the same webhook event.
// Without recording which externalEventId we've already processed, a retried
// "payment succeeded" event could double-process a subscription activation.
model PaymentWebhookEvent {
  id             String   @id @default(cuid())
  provider       PaymentProviderType
  externalEventId String
  type           String
  processedAt    DateTime @default(now())

  @@unique([provider, externalEventId])
}

// ---------- Email (SMTP) ----------
// Platform-level, singleton in practice — one SMTP config sends all
// transactional email (password reset, invites, alerts). Swapping providers
// later (Titan -> a dedicated transactional service) is just updating these
// fields, no code change and no redeploy.

model EmailSettings {
  id           String   @id @default(cuid())
  host         String
  port         Int
  secure       Boolean  @default(true)
  username     String
  encryptedPassword String
  fromEmail    String
  fromName     String   @default("Anadash")
  isActive     Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

// ---------- Audit log ----------

// Minimal, scoped audit trail — currently only used for account-security
// events (email verification, admin-mediated email changes). Intentionally
// has no FK relation to User: an audit row must survive the target account
// being deleted later, so target identity is captured as a plain snapshot
// (targetId/targetEmail) rather than a live relation. Never store secrets,
// tokens, or passwords in metadata.
model AuditLog {
  id          String   @id @default(cuid())
  event       String
  actorId     String?
  actorEmail  String?
  targetId    String?
  targetEmail String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([event])
  @@index([targetId])
  @@index([createdAt])
}

// ---------- Password reset ----------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // Store a hash of the token, never the raw value — same principle as a
  // password hash, so a DB read alone can't be used to reset someone's account.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Team invites ----------

model Invite {
  id              String         @id @default(cuid())
  organizationId  String
  email           String
  role            MembershipRole @default(MEMBER)
  tokenHash       String         @unique
  status          InviteStatus   @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  createdAt       DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// ---------- Seller channels ----------
// Deliberately separate from Connector (which is platform-wide research data,
// shared across customers). A SellerChannel is one specific customer's own
// authenticated store — their own credentials, their own data. Powers both
// the Unified Analytics Dashboard (read) and, later, Cross-Listing (write).
// Never conflate this with Connector even though both may reference "Etsy" —
// one is market-wide research, this is one customer's own account.

model SellerChannel {
  id             String   @id @default(cuid())
  organizationId String
  platform       SellerChannelPlatform
  label          String
  storeUrl       String
  encryptedCredentials String
  status         ConnectorStatus @default(ACTIVE)
  lastSyncedAt   DateTime?
  lastSyncError  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       SellerOrder[]
  crossListingEntries CrossListingEntry[]
  listingDrafts ListingDraft[]
  listingSeoAudits ListingSeoAudit[]
  etsyExecutionLogs EtsyExecutionLog[]

  @@unique([organizationId, storeUrl])
  @@index([organizationId])
}

enum SellerChannelPlatform {
  SHOPIFY
  WOOCOMMERCE
  ETSY_SELLER
  EBAY_SELLER
}

model SellerOrder {
  id              String   @id @default(cuid())
  sellerChannelId String
  externalOrderId String
  orderNumber     String?
  totalAmount     Float
  currency        String
  status          String
  placedAt        DateTime
  createdAt       DateTime @default(now())

  sellerChannel SellerChannel @relation(fields: [sellerChannelId], references: [id], onDelete: Cascade)

  @@unique([sellerChannelId, externalOrderId])
  @@index([sellerChannelId])
  @@index([placedAt])
}

// ---------- App settings ----------
// Generic key-value store for admin-editable config (affiliate links, order
// form URLs, platform app credentials like Shopify's Client ID/Secret).
// Deliberately generic rather than one field per setting, so adding a new
// configurable value never needs a schema migration — just a new key.

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // encrypted at rest when isSecret is true
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ---------- Cross-listing ----------
// Foundation only in this round — the data model, not the actual push/sync
// logic yet. A CrossListing groups one logical product across multiple
// SellerChannel connections (e.g. the same item on both a customer's Etsy
// shop and their WooCommerce store). One entry is flagged isSource — the
// platform treated as the source of truth when fields conflict.

model CrossListing {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      CrossListingEntry[]

  @@index([organizationId])
}

model CrossListingEntry {
  id                String    @id @default(cuid())
  crossListingId    String
  sellerChannelId   String
  externalListingId String?   // null until actually pushed/created on that platform
  isSource          Boolean   @default(false)
  lastPushedAt      DateTime?
  lastPushError     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  crossListing  CrossListing  @relation(fields: [crossListingId], references: [id], onDelete: Cascade)
  sellerChannel SellerChannel @relation(fields: [sellerChannelId], references: [id], onDelete: Cascade)

  @@unique([crossListingId, sellerChannelId])
  @@index([crossListingId])
  @@index([sellerChannelId])
}

// ==========================================
// ---------- Phase A Foundation ------------
// ==========================================

// ---------- 1. Unified Planner & Workbench ----------
// Universal strategic planning unit bridging research discovery into execution.
// Supports product ideas, shop benchmarks, keyword clusters, SEO optimization tasks,
// content ideas, and listing concepts while preserving original research provenance.

model PlannerItem {
  id                   String            @id @default(cuid())
  organizationId       String
  userId               String?
  type                 PlannerItemType
  title                String
  status               PlannerItemStatus @default(BACKLOG)
  priority             Int               @default(3) // 1=Highest, 5=Lowest
  notes                String?           @db.Text
  metadata             Json?

  // Provenance & Source Reference (Inspiration, NOT Copying)
  sourceType           String?           // e.g. "PROSPECT", "SHOP", "KEYWORD", "SEO_AUDIT", "MANUAL"
  sourceId             String?           // Identifier of source entity
  sourceShopExternalId String?
  sourceShopName       String?
  sourceListingUrl     String?
  sourceListingTitle   String?
  researchSnapshot     Json?             // Frozen metrics at time of planning (price, velocity, tags, etc.)

  // Strategic Planning Targets
  targetCategory       String?
  targetPrice          Float?
  estimatedCogs        Float?
  targetKeywords       String[]          @default([])
  dueDate              DateTime?
  completedAt          DateTime?

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  listingDrafts        ListingDraft[]
  seoAudits            ListingSeoAudit[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([sourceId])
  @@index([userId])
}

enum PlannerItemType {
  PRODUCT_RESEARCH
  SHOP_RESEARCH
  KEYWORD_RESEARCH
  CONTENT_IDEA
  LISTING_CONCEPT
  SEO_TASK
  EXECUTION_TASK
}

enum PlannerItemStatus {
  BACKLOG
  IN_PROGRESS
  READY_FOR_DRAFT
  DRAFT_CREATED
  PUBLISHED_TO_ETSY
  COMPLETED
  ARCHIVED
}

// ---------- 2. Listing Drafts ----------
// Internal draft representation before Etsy API write-back.
// Stores optimized titles, 13 tags, structured descriptions, originality score,
// and execution state.

model ListingDraft {
  id                           String             @id @default(cuid())
  organizationId               String
  plannerItemId                String?
  sellerChannelId              String?            // Target connected Etsy store

  // Content Fields
  title                        String             // Etsy limit: 140 chars
  description                  String             @db.Text
  tags                         String[]           @default([]) // Exactly <= 13 tags, each <= 20 chars
  materials                    String[]           @default([])
  taxonomyId                   Int?               // Etsy taxonomy node ID
  price                        Float
  quantity                     Int                @default(999)
  whoMade                      String             @default("i_did") // i_did, someone_else, collective
  whenMade                     String             @default("2020_2026")
  isSupply                     Boolean            @default(false)
  isCustomizable               Boolean            @default(false)
  personalizationInstructions  String?            @db.Text
  state                        String             @default("draft") // "draft" | "active"

  // AI Generation & Originality Metadata
  generationPrompt             String?            @db.Text
  aiModelUsed                  String?            // e.g. "openai/gpt-4o-mini"
  generationMetadata           Json?
  originalityScore             Float?             // 0-100 (100 = completely unique vs source)
  originalityStatus            String?            // "PASSED" | "FLAGGED" | "REJECTED"
  maxCommonSubstring           Int?               // Longest matching phrase count vs source listing
  seoScore                     Int?               // [SELLERSALT SCORE] 0-100

  // State & Execution
  status                       ListingDraftStatus @default(DRAFT)
  etsyListingId                String?            // Set after successful draft creation on Etsy
  etsyDraftUrl                 String?
  lastPushedAt                 DateTime?
  lastPushError                String?

  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  organization                 Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plannerItem                  PlannerItem?       @relation(fields: [plannerItemId], references: [id], onDelete: SetNull)
  sellerChannel                SellerChannel?     @relation(fields: [sellerChannelId], references: [id], onDelete: SetNull)
  seoAudits                    ListingSeoAudit[]
  executionLogs                EtsyExecutionLog[]

  @@index([organizationId])
  @@index([plannerItemId])
  @@index([sellerChannelId])
  @@index([status])
  @@index([etsyListingId])
}

enum ListingDraftStatus {
  DRAFT
  GENERATED
  EDITED_BY_USER
  APPROVED
  PUSHED_TO_ETSY
  REJECTED
  ARCHIVED
}

// ---------- 3. Listing SEO Audits ----------
// Persistent diagnostic SEO audits evaluating titles, 13 tags, synergy,
// descriptions, taxonomy, and attribute completeness.

model ListingSeoAudit {
  id                   String        @id @default(cuid())
  organizationId       String
  plannerItemId        String?
  listingDraftId       String?
  sellerChannelId      String?
  externalListingId    String?       // For auditing live external/connected listings

  // Rubric Scores (0-100) — [SELLERSALT SCORE]
  overallScore         Int           // 0-100
  titleScore           Int           // 0-100
  tagScore             Int           // 0-100
  keywordSynergyScore  Int           // 0-100 (synergy between title & tags)
  descriptionScore     Int           // 0-100
  taxonomyScore        Int           // 0-100
  attributeScore       Int           // 0-100

  // Diagnostic Measurements
  titleCharCount       Int
  tagCount             Int           // Target: 13
  tagsOver20Chars      String[]      @default([])
  duplicateTags        String[]      @default([])
  singleWordTags       String[]      @default([])
  missingAttributes    String[]      @default([])

  // Structured Issues & Recommendations
  diagnostics          Json          // Array of { code, severity, title, message, recommendation, pointsDeducted }
  recommendations      Json          // Array of actionable fix recommendations
  beforeAfterState     Json?         // { originalState, proposedState, projectedScore }

  provenance           String        @default("SELLERSALT_SCORE")
  auditVersion         String        @default("1.0")

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plannerItem          PlannerItem?  @relation(fields: [plannerItemId], references: [id], onDelete: SetNull)
  listingDraft         ListingDraft? @relation(fields: [listingDraftId], references: [id], onDelete: SetNull)
  sellerChannel        SellerChannel? @relation(fields: [sellerChannelId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([plannerItemId])
  @@index([listingDraftId])
  @@index([externalListingId])
  @@index([sellerChannelId])
}

// ---------- 4. Etsy API Execution & Audit Logs ----------
// Idempotent execution log recording every Etsy write operation (draft creation,
// updates, image uploads) with request/response payloads, status codes, and actor stamps.

model EtsyExecutionLog {
  id                   String                  @id @default(cuid())
  organizationId       String
  userId               String?
  sellerChannelId      String?
  listingDraftId       String?
  operationType        EtsyExecutionOperation
  entityType           String                  // "LISTING", "IMAGE", "INVENTORY", "RECEIPT"
  entityId             String?                 // Internal ID (e.g. listingDraftId)
  etsyResourceId       String?                 // External Etsy ID (e.g. listing_id)
  idempotencyKey       String                  @unique
  requestPayload       Json
  responseStatusCode   Int?
  responsePayload      Json?
  status               EtsyExecutionStatus     @default(PENDING)
  errorMessage         String?

  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sellerChannel        SellerChannel?          @relation(fields: [sellerChannelId], references: [id], onDelete: SetNull)
  listingDraft         ListingDraft?           @relation(fields: [listingDraftId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([sellerChannelId])
  @@index([listingDraftId])
  @@index([status])
  @@index([createdAt])
}

enum EtsyExecutionOperation {
  CREATE_DRAFT_LISTING
  UPDATE_LISTING
  UPLOAD_LISTING_IMAGE
  DELETE_LISTING_IMAGE
  UPDATE_INVENTORY
  PUBLISH_LISTING
  SYNC_RECEIPTS
}

enum EtsyExecutionStatus {
  PENDING
  IN_PROGRESS
  SUCCESS
  FAILED
  RETRYING
}

