// Anadash data model
// Multi-tenant from day one: every business-data table carries organizationId,
// even though the UI only exposes a single org per user for now.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity & tenancy ----------

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      Plan     @default(FREE)
  packageId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  connectors  Connector[]
  searchConfigs SearchConfig[]
  prospects   Prospect[]
  jobs        Job[]
  shopWatches ShopWatch[]
  package     Package?     @relation(fields: [packageId], references: [id])
  invites     Invite[]
  sellerChannels SellerChannel[]
}

enum Plan {
  FREE
  PRO
  AGENCY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  passwordResetTokens PasswordResetToken[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(OWNER)
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

// ---------- Marketplace connectors ----------
// One row per (organization, marketplace) connection. Etsy is connector #1;
// Amazon/AliExpress/Shopify sourcing etc. reuse this same table + a `type` discriminator.

model Connector {
  id             String   @id @default(cuid())
  // Nullable: null means this is a platform-owned connector, shared by every
  // paying org (the normal case — customers don't bring their own API key,
  // they just use the service). Non-null means an org brought its own key,
  // an opt-in premium option, not something a regular user is asked to do.
  organizationId String?
  type           ConnectorType
  label          String   // user-facing name, e.g. "Etsy - Netdrix Sourcing"
  // Secrets are encrypted at rest (see src/lib/encryption.ts) before being stored here.
  encryptedCredentials String
  status         ConnectorStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  searchConfigs SearchConfig[]
  jobs         Job[]
  shopWatches  ShopWatch[]

  @@index([organizationId])
}

enum ConnectorType {
  ETSY
  // AMAZON, ALIEXPRESS, SHOPIFY_SOURCING, etc. added as phase 2 connectors ship
}

enum ConnectorStatus {
  ACTIVE
  ERROR
  DISABLED
}

// ---------- User-defined search / prospecting configs ----------
// This replaces the old .env keyword list — now editable per-org in the dashboard.

model SearchConfig {
  id             String   @id @default(cuid())
  organizationId String
  connectorId    String
  name           String
  keywords       String[] // e.g. ["digital planner", "svg bundle"]
  minPrice       Float
  maxPrice       Float
  minShopAgeMonths Float  @default(12)
  maxShopAgeMonths Float  @default(24)
  minReviewCount   Int    @default(20)
  scheduleCron   String?  // null = manual run only
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector    Connector    @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  jobs         Job[]
  prospects    Prospect[]

  @@index([organizationId])
}

// ---------- Jobs (background runs, replaces the old cron-only script) ----------

model Job {
  id             String   @id @default(cuid())
  organizationId String
  connectorId    String
  searchConfigId String
  status         JobStatus @default(QUEUED)
  triggeredBy    JobTrigger @default(USER)
  startedAt      DateTime?
  finishedAt     DateTime?
  resultCount    Int?
  errorMessage   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector    Connector    @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  searchConfig SearchConfig @relation(fields: [searchConfigId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
}

enum JobTrigger {
  USER
  SCHEDULE
}

// ---------- Prospects (the actual output data, replaces the Google Sheet) ----------

model Prospect {
  id             String   @id @default(cuid())
  organizationId String
  searchConfigId String
  jobId          String?
  marketplace    ConnectorType @default(ETSY)
  keyword        String
  // External marketplace IDs — present on every row, including historical ones,
  // so repeated runs of the same search naturally form a time series per shop
  // and per listing without needing a separate snapshot table.
  shopExternalId    String
  listingExternalId String
  shopName       String
  shopUrl        String
  shopIconUrl    String?
  shopAgeMonths  Float
  reviewCount    Int
  activeListings Int
  reviewRatio    Float
  reviewVelocity Float
  // Real lifetime sales count (Etsy's transaction_sold_count) where the marketplace
  // exposes it — not a proxy. avgSellingRatio/estDailySales are derived from this.
  totalSales      Int?
  reviewAverage   Float?
  numFavorers     Int?
  avgSellingRatio Float?
  estDailySales   Float?
  listingTitle    String
  listingUrl      String
  listingImageUrl String?
  price          Float
  status         ProspectStatus @default(PENDING_REVIEW)
  isFavorite     Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  searchConfig SearchConfig @relation(fields: [searchConfigId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([isFavorite])
  @@index([shopExternalId])
  @@index([listingExternalId])
  @@index([jobId])
}

enum ProspectStatus {
  PENDING_REVIEW
  SHORTLISTED
  CONTACTED
  REJECTED
}

// ---------- Shop tracking ("Spy on Competitor") ----------
// Independent of SearchConfig: a user can start tracking any shop they find in
// Prospects, regardless of which search surfaced it. A repeatable BullMQ job
// (one per ShopWatch) re-fetches just that shop's stats on a schedule and
// appends a ShopSnapshot — the interactive sales-trend graph on the shop page
// is built entirely from this table.

model ShopWatch {
  id             String   @id @default(cuid())
  organizationId String
  connectorId    String
  shopExternalId String
  shopName       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector    Connector       @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  snapshots    ShopSnapshot[]

  @@unique([organizationId, shopExternalId])
  @@index([organizationId])
}

model ShopSnapshot {
  id             String   @id @default(cuid())
  shopWatchId    String
  totalSales     Int?
  reviewCount    Int
  reviewAverage  Float?
  activeListings Int
  numFavorers    Int?
  capturedAt     DateTime @default(now())

  shopWatch ShopWatch @relation(fields: [shopWatchId], references: [id], onDelete: Cascade)

  @@index([shopWatchId])
}

// ---------- Packages (plan tiers) ----------
// Replaces hardcoded plan limits with DB-editable rows, so pricing/limits can
// change without a redeploy. Three standard tiers (Free/Pro/Agency) seed
// automatically on first use; isCustom rows are one-off overrides an admin
// assigns to a specific org (special deals, beta customers, etc.).

model Package {
  id       String  @id @default(cuid())
  key      String  @unique
  name     String
  priceUsd Float   @default(0)
  isCustom Boolean @default(false)

  maxConnectors        Int @default(1)
  maxSearchConfigs     Int @default(3)
  maxScheduledSearches Int @default(1)
  maxTrackedShops      Int @default(5)
  maxProspectsPerMonth Int @default(200)
  maxSellerChannels    Int @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]
}

// ---------- Payment providers ----------
// Platform-level, not per-org — Anadash itself is the merchant of record.
// Credentials are stored encrypted at rest, same pattern as marketplace
// Connector. Live checkout/webhook handling per provider is a separate,
// later increment — this is the admin-side "store the credentials, mark
// which ones are active" foundation that unlocks it without a schema change.

model PaymentProvider {
  id       String              @id @default(cuid())
  provider PaymentProviderType @unique
  label    String
  isActive Boolean             @default(false)
  encryptedCredentials String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentProviderType {
  STRIPE
  PAYPAL
  SAFEPAY
  PAYFAST
}

// ---------- Email (SMTP) ----------
// Platform-level, singleton in practice — one SMTP config sends all
// transactional email (password reset, invites, alerts). Swapping providers
// later (Titan -> a dedicated transactional service) is just updating these
// fields, no code change and no redeploy.

model EmailSettings {
  id           String   @id @default(cuid())
  host         String
  port         Int
  secure       Boolean  @default(true)
  username     String
  encryptedPassword String
  fromEmail    String
  fromName     String   @default("Anadash")
  isActive     Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

// ---------- Password reset ----------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // Store a hash of the token, never the raw value — same principle as a
  // password hash, so a DB read alone can't be used to reset someone's account.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Team invites ----------

model Invite {
  id              String         @id @default(cuid())
  organizationId  String
  email           String
  role            MembershipRole @default(MEMBER)
  tokenHash       String         @unique
  status          InviteStatus   @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  createdAt       DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// ---------- Seller channels ----------
// Deliberately separate from Connector (which is platform-wide research data,
// shared across customers). A SellerChannel is one specific customer's own
// authenticated store — their own credentials, their own data. Powers both
// the Unified Analytics Dashboard (read) and, later, Cross-Listing (write).
// Never conflate this with Connector even though both may reference "Etsy" —
// one is market-wide research, this is one customer's own account.

model SellerChannel {
  id             String   @id @default(cuid())
  organizationId String
  platform       SellerChannelPlatform
  label          String
  storeUrl       String
  encryptedCredentials String
  status         ConnectorStatus @default(ACTIVE)
  lastSyncedAt   DateTime?
  lastSyncError  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       SellerOrder[]

  @@index([organizationId])
}

enum SellerChannelPlatform {
  SHOPIFY
  WOOCOMMERCE
  ETSY_SELLER
  EBAY_SELLER
}

model SellerOrder {
  id              String   @id @default(cuid())
  sellerChannelId String
  externalOrderId String
  orderNumber     String?
  totalAmount     Float
  currency        String
  status          String
  placedAt        DateTime
  createdAt       DateTime @default(now())

  sellerChannel SellerChannel @relation(fields: [sellerChannelId], references: [id], onDelete: Cascade)

  @@unique([sellerChannelId, externalOrderId])
  @@index([sellerChannelId])
  @@index([placedAt])
}
