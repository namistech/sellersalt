model Prospect {
  id             String   @id @default(cuid())
  organizationId String
  searchConfigId String
  marketplace    ConnectorType @default(ETSY)
  keyword        String
  shopName       String
  shopUrl        String
  shopIconUrl    String?
  shopAgeMonths  Float
  reviewCount    Int
  activeListings Int
  reviewRatio    Float
  reviewVelocity Float
  totalSales      Int?
  reviewAverage   Float?
  numFavorers     Int?
  avgSellingRatio Float?
  estDailySales   Float?
  listingTitle    String
  listingUrl      String
  listingImageUrl String?
  price          Float
  status         ProspectStatus @default(PENDING_REVIEW)
  isFavorite     Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  searchConfig SearchConfig @relation(fields: [searchConfigId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([isFavorite])
}